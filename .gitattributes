# Normalize line endings: LF in the repository and in the working tree.
* text=auto eol=lf

# Windows scripts need CRLF (e.g. mvnw.cmd).
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never convert or diff as text.
*.jar binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
