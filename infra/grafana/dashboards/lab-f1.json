{
  "uid": "lab-f1",
  "title": "Lab — Faults",
  "tags": [
    "kintsugi",
    "lab",
    "f1",
    "f2",
    "f3",
    "f4"
  ],
  "description": "Fault F1 (gateway latency): pending orders pile up, gateway authorizations stay in flight, payment-service slows and returns 503, order-service logs WARN. Fault F2 (gateway 429): failed payments and PAYMENT_FAILED orders rise, payment-service logs a WARN line per rejected payment. Fault F4 (inventory DB pool exhausted): the inventory pool runs at its size with pending connections and timeouts, inventory answers 500 on /reservations, order-service answers 503 and logs WARN.",
  "editable": false,
  "schemaVersion": 41,
  "version": 3,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Orders by status",
      "description": "Stored orders per status. Under F1, PAYMENT_PENDING rises; under F2, PAYMENT_FAILED rises.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status) (lab_orders)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Gateway in-flight authorizations",
      "description": "Authorizations the gateway is still holding. Above 0 while F1 delays them.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "gateway_authorize_inflight",
          "legendFormat": "in flight"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "payment-service /payments latency and 503 rate",
      "description": "Mean request latency of POST /payments and the rate of 503 responses.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "503 per second"
            },
            "properties": [
              {
                "id": "unit",
                "value": "reqps"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_server_requests_seconds_sum{service=\"payment-service\",uri=\"/payments\"}[1m])) / sum(rate(http_server_requests_seconds_count{service=\"payment-service\",uri=\"/payments\"}[1m]))",
          "legendFormat": "mean latency (s)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{service=\"payment-service\",uri=\"/payments\",status=\"503\"}[1m]))",
          "legendFormat": "503 per second"
        }
      ]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "order-service WARN lines",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service=\"order-service\"} |= \"WARN\""
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Payments by status",
      "description": "Stored payments per status. Under F2, FAILED rises.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status) (lab_payments)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Gateway rejections",
      "description": "payment-service WARN lines for a gateway 429, per minute. Above 0 while F2 is active. From the logs, so it names the cause (the gateway's 429), not only the effect.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service=\"payment-service\"} |= \"Gateway rejected the payment\" [1m]))",
          "legendFormat": "429 rejections per minute"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "order-service → payment calls by outcome",
      "description": "order-service's calls to payment-service per second, by outcome and exception (http.client.requests). Under F3 (wrong payment URL) the calls fail at once with exception ConnectException; under F1 (slow gateway) they end after the read timeout with HttpTimeoutException.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (outcome, exception) (rate(http_client_requests_seconds_count{service=\"order-service\",client_name=\"payment-service\"}[1m]))",
          "legendFormat": "{{outcome}} {{exception}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "inventory DB pool",
      "description": "inventory-service's Hikari connection pool: active, idle and pending connections, and connection timeouts per second. Under F4 (pool of 2, slow reservation query) active sits at the pool size, pending rises above 0 and timeouts appear; each timeout is a 500 on POST /reservations.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "timeouts per second"
            },
            "properties": [
              {
                "id": "unit",
                "value": "reqps"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(hikaricp_connections_active{service=\"inventory-service\"})",
          "legendFormat": "active"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(hikaricp_connections_idle{service=\"inventory-service\"})",
          "legendFormat": "idle"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(hikaricp_connections_pending{service=\"inventory-service\"})",
          "legendFormat": "pending"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(hikaricp_connections_timeout_total{service=\"inventory-service\"}[1m]))",
          "legendFormat": "timeouts per second"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "inventory 5xx rate",
      "description": "inventory-service responses with a 5xx status per second, by URI and status. Under F4 POST /reservations answers 500 when no pooled connection frees up within the 2 s connection timeout; order-service then answers 503.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (uri, status) (rate(http_server_requests_seconds_count{service=\"inventory-service\",status=~\"5..\"}[1m]))",
          "legendFormat": "{{uri}} {{status}}"
        }
      ]
    }
  ]
}
